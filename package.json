{
  "name": "elysium-browser",
  "version": "1.5.0",
  "description": "elysium-browser — a little space for your curiosity. A Windows desktop web browser.",
  "main": "src/main.js",
  "author": "Heaven Technology Group Co., Ltd. and Heaven Technologies",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/core.test.js tests/calendar.test.js tests/themes.test.js",
    "test:e2e": "playwright test",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/core.js && node --check src/renderer.js && node --check src/icons.js && node --check src/providers.js && node --check src/oauth.js && node --check src/providers.js",
    "test:native": "node scripts/test-native-lifecycle.js",
    "assets:export": "node scripts/export-anime-assets.js",
    "assets:icon": "node scripts/build-app-icon.js",
    "build": "electron-builder --win portable nsis",
    "build:installer": "electron-builder --win nsis",
    "build:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "sharp": "^0.35.4"
  },
  "build": {
    "appId": "com.elysium.browser",
    "productName": "elysium-browser",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Heaven-Technology-Group-Co-Ltd",
      "repo": "elysium-browser"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/elysium.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "elysium-browser-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "elysium-browser",
      "artifactName": "elysium-browser-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
